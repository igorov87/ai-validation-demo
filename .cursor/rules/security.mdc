## Configuración Segura de Axios

OBLIGATORIO - Interceptores con manejo seguro:

```javascript
// src/api/requerimientos.js
import axios from 'axios'
import config from '@/config'

const requerimientosApi = axios.create({
  baseURL: config.API_REQUERIMIENTOS_URL,
  timeout: 30000,
  headers: {
    'Content-Type': 'application/json'
  }
})

// Interceptor de REQUEST
requerimientosApi.interceptors.request.use(
  (config) => {
    // Agregar token de autenticación si existe
    const token = localStorage.getItem('auth_token')
    if (token) {
      config.headers.Authorization = `Bearer ${token}`
    }

    // Sanitizar parámetros de query
    if (config.params) {
      Object.keys(config.params).forEach((key) => {
        if (typeof config.params[key] === 'string') {
          config.params[key] = config.params[key].trim()
        }
      })
    }

    // Log en desarrollo (sin datos sensibles)
    if (import.meta.env.DEV) {
      console.log(`🚀 [API Request] ${config.method?.toUpperCase()} ${config.url}`)
    }

    return config
  },
  (error) => {
    console.error('❌ Error en request:', error)
    return Promise.reject(error)
  }
)

// Interceptor de RESPONSE
requerimientosApi.interceptors.response.use(
  (response) => {
    return response
  },
  (error) => {
    const statusCode = error.response?.status

    // NO exponer detalles del servidor en producción
    if (import.meta.env.PROD) {
      // Log mínimo en producción
      console.error(`API Error ${statusCode}`)
    } else {
      // Log detallado en desarrollo
      console.error('API Error:', {
        url: error.config?.url,
        method: error.config?.method,
        statusCode,
        message: error.message
      })
    }

    // Manejo específico por código
    switch (statusCode) {
      case 401:
        // Sesión expirada - limpiar y redirigir
        localStorage.clear()
        window.location.href = '/login?error=sesion-expirada'
        break
      
      case 403:
        console.warn('⚠️ Acceso denegado')
        break
      
      case 404:
        console.warn('⚠️ Recurso no encontrado')
        break
      
      case 422:
        // Error de validación
        console.warn('⚠️ Error de validación')
        break
      
      case 500:
      case 502:
      case 503:
        console.error('🔥 Error del servidor')
        break
    }

    // Retornar error estructurado (sin exponer detalles sensibles)
    return Promise.reject({
      message: error.response?.data?.message || 'Error en la operación',
      statusCode: statusCode || 500
    })
  }
)

export default requerimientosApi
```

## Protección de Tokens

OBLIGATORIO - Manejo seguro de tokens:

```javascript
// ❌ PROHIBIDO - Almacenar credenciales en localStorage
localStorage.setItem('password', 'secreto123')
localStorage.setItem('username', 'usuario')

// ✅ CORRECTO - Solo tokens temporales con expiración
const guardarToken = (tokenData) => {
  localStorage.setItem('auth_token', tokenData.accessToken)
  localStorage.setItem('token_expiry', tokenData.expiresAt)
}

// ✅ CORRECTO - Verificar expiración antes de usar
const getToken = () => {
  const token = localStorage.getItem('auth_token')
  const expiry = localStorage.getItem('token_expiry')
  
  if (!token || !expiry) {
    return null
  }
  
  // Verificar si expiró
  if (new Date(expiry) < new Date()) {
    localStorage.clear()
    return null
  }
  
  return token
}

// ✅ CORRECTO - Limpiar al cerrar sesión
const cerrarSesion = () => {
  localStorage.removeItem('auth_token')
  localStorage.removeItem('token_expiry')
  window.location.href = '/login'
}
```

