## Límites de Tamaño

OBLIGATORIO - Limitar tamaño de datos enviados:

```javascript
const LIMITES = {
  NOMBRE_CLIENTE: 100,
  NUMERO_POLIZA: 50,
  TELEFONO: 15,
  EMAIL: 100,
  DESCRIPCION: 5000,
  OBSERVACIONES: 2000
}

const validarLongitud = (valor, campo, limite) => {
  if (valor && valor.length > limite) {
    throw new Error(`${campo} no puede exceder ${limite} caracteres`)
  }
}

const validarRequerimiento = (data) => {
  validarLongitud(data.nombreCliente, 'Nombre del cliente', LIMITES.NOMBRE_CLIENTE)
  validarLongitud(data.numeroPoliza, 'Número de póliza', LIMITES.NUMERO_POLIZA)
  validarLongitud(data.telefono, 'Teléfono', LIMITES.TELEFONO)
  validarLongitud(data.email, 'Email', LIMITES.EMAIL)
  validarLongitud(data.descripcion, 'Descripción', LIMITES.DESCRIPCION)
  validarLongitud(data.observaciones, 'Observaciones', LIMITES.OBSERVACIONES)
}
```

